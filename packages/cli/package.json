{
  "name": "@specbook/cli",
  "version": "0.9.1",
  "description": "Specbook command line: init, add, generate, dev, build, test, bundle, check, secrets and preview.",
  "keywords": [
    "specbook",
    "openapi",
    "swagger",
    "cli",
    "api-explorer",
    "api-testing"
  ],
  "license": "FSL-1.1-MIT",
  "homepage": "https://ui.specbook.dev",
  "bugs": {
    "url": "https://github.com/specbook-dev/specbook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specbook-dev/specbook.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "bin": {
    "specbook": "./dist/bin.js"
  },
  "files": [
    "dist",
    "agent-guide.md",
    "!**/*.test.*"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:slow": "vitest run --config vitest.slow.config.ts"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "10.1.1",
    "@faker-js/faker": "9.3.0",
    "@specbook/codegen": "workspace:*",
    "@specbook/core": "workspace:*",
    "@specbook/ui": "workspace:*",
    "@specbook/vite": "workspace:*",
    "fast-glob": "3.3.2",
    "rolldown": "1.2.13",
    "swagger2openapi": "7.0.8",
    "vite": "8.3.4",
    "vite-node": "6.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsup": "8.5.1",
    "typescript": "7.0.2"
  }
}
