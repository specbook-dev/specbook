{
  "name": "@specbook/ui",
  "version": "0.2.0",
  "description": "The Specbook docs app, spec viewer and embeddable specbook.js.",
  "keywords": [
    "specbook",
    "openapi",
    "swagger",
    "api-documentation",
    "api-explorer",
    "openapi-viewer"
  ],
  "license": "MIT",
  "homepage": "https://ui.specbook.dev",
  "bugs": {
    "url": "https://github.com/specbook-dev/specbook/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/specbook-dev/specbook.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "pnpm --filter @specbook/vite build && vitest run --config vitest.browser.config.ts",
    "build:viewer": "vite build --config vite.viewer.config.ts",
    "dev:viewer": "vite --config vite.viewer.config.ts",
    "test:viewer": "pnpm run build:viewer && vitest run --config vitest.viewer.config.ts",
    "test:oauth": "pnpm --filter @specbook/cli build && pnpm run build:viewer && vitest run --config vitest.oauth.config.ts",
    "build:site": "pnpm run build:viewer && node scripts/assemble-site.mjs",
    "deploy:site": "pnpm run build:viewer && node scripts/assemble-site.mjs --previous https://ui.specbook.dev && npx --yes wrangler@4 pages deploy dist-site --project-name specbook-ui --branch main",
    "test:embed": "pnpm --filter @specbook/cli build && vitest run --config vitest.embed.config.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.3",
    "@specbook/codegen": "workspace:*",
    "@specbook/core": "workspace:*",
    "preact": "11.0.1",
    "prism-code-editor": "^5.4.0"
  },
  "devDependencies": {
    "@faker-js/faker": "9.3.0",
    "@specbook/vite": "workspace:*",
    "@vitest/browser-playwright": "5.0.3",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "files": [
    "src",
    "index.html",
    "dist-viewer",
    "!**/*.test.*"
  ]
}
