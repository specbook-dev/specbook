{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/dist-docs",
      "!**/dist-viewer",
      "!**/dist-site",
      "!**/.generated",
      "!**/node_modules",
      "!docs",
      "!**/dist-sw",
      "!**/dist-qa",
      "!**/dist-bundle",
      "!**/captures",
      "!**/.astro",
      "!**/openapi",
      "!**/.turbo",
      "!**/.venv",
      "!**/.mypy_cache",
      "!**/.ruff_cache",
      "!**/.pytest_cache"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noTemplateCurlyInString": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noBannedTypes": "off"
      },
      "correctness": {
        "useJsxKeyInIterable": "off",
        "useExhaustiveDependencies": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}
