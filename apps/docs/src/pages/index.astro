---
import Snippet from '../components/Snippet.astro'
import Page from '../layouts/Page.astro'
import { PAGES } from '../lib/pages'
---

<Page
  home
  title="Specbook: Storybook for APIs"
  description="The Swagger UI alternative built for modern teams. Explore APIs, author executable flows once, and publish live documentation instantly."
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Storybook for APIs</span>
      <h1 class="display">API docs that come to life</h1>
      <p class="lede">
        The Swagger UI alternative built for modern teams. Explore APIs, author executable flows once, and
        publish live documentation instantly. Share everything in a centralized portal and continuously verify
        your endpoints in production.
      </p>
      <div class="hero-actions">
        <a class="btn primary" href="#try">Run one now</a>
        <a class="btn" href="/develop/">Start with your spec</a>
      </div>
    </div>
  </section>

  <section class="block" id="try">
    <div class="wrap">
      <h2 class="title">Try it right here</h2>
      <p class="lede" style="margin-top: 0">
        This is a real request. Press Run to send it to the public Swagger Petstore and see the response checked
        against the spec. Or run a flow, which chains requests: find a pet, order it,
        check the order.
      </p>
      <div class="demo">
        <div class="demo-bar">
          <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span>get-pet.req.ts</span>
          <span class="grow"></span>
        </div>
        <div class="demo-body">
          <Snippet file="demo/requests/petstore/get-pet.req.ts" region="request" title={false} />
          <p class="actions">
            <button type="button" class="run" data-specbook-try="petstore/GetPetById" data-specbook-env="live">
              ▶ Run this request
            </button>
            <button type="button" class="run" data-specbook-flow="adopt-pet" data-specbook-env="live">
              ▶ Run a flow: adopt a pet
            </button>
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="title">From first look to production.</h2>
      <div class="tiles">
        {
          PAGES.map((p, i) => (
            <a class="tile" href={`/${p.slug}/`}>
              <span class="num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.name}</h3>
              <p>{p.line}</p>
              <span class="go">Open →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <h2 class="title">Start in a minute.</h2>
      <div class="prose">
        <p>Needs Node 24. Point it at any OpenAPI file or address; the rest is generated.</p>
      </div>
      <Snippet file="snippets/install.sh" region="install" title="terminal" />
    </div>
  </section>
</Page>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 4px 0 0;
  }
</style>
