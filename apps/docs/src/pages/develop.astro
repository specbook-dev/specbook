---
import Next from '../components/Next.astro'
import Replay from '../components/Replay'
import Snippet from '../components/Snippet.astro'
import Page from '../layouts/Page.astro'
import { capture } from '../lib/captures'
---

<Page
  page="develop"
  title="Develop"
  description="Turn your OpenAPI file into typed operations. Write requests and flows in TypeScript, run them as you write, then publish them for your team."
>
  <section class="hero" style="padding-bottom: 24px">
    <div class="wrap">
      <span class="eyebrow">01 · Develop</span>
      <h1 class="display">Your spec, as code you can run.</h1>
      <p class="lede">
        Specbook turns your OpenAPI file into typed operations you can use directly in TypeScript. Write
        requests and flows with autocomplete and type checking for every path, query, and body, and run them as
        you write.
      </p>
    </div>
  </section>

  <section class="block" style="padding-top: 8px">
    <div class="wrap">
      <h2 class="title">Add your spec</h2>
      <div class="prose">
        <p>
          Install the CLI, create a project and add your OpenAPI file or an address. Specbook generates a typed
          operation for every endpoint.
        </p>
      </div>
      <Snippet file="snippets/install.sh" region="install" title={false} />
      <Replay client:visible capture={capture('develop-setup')} title="" />

      <h2 class="title">Write a request</h2>
      <div class="prose">
        <p>
          A request calls one operation. Your editor autocompletes the path, query, and body from the spec, and
          your checks decide what counts as a pass.
        </p>
      </div>
      <Snippet file="demo/requests/petstore/get-pet.req.ts" region="request" />

      <h2 class="title">Chain requests into a flow</h2>
      <div class="prose">
        <p>
          A flow runs requests in order, and each step can use what the one before it returned. The types come
          from your spec, so a misspelt field is caught as you type, not at run time.
        </p>
      </div>
      <Snippet file="demo/sequences/adopt-pet.seq.ts" region="flow" />

      <h2 class="title">Run it as you write</h2>
      <div class="prose">
        <p>
          Run <code>specbook dev</code> to try every request and flow in a play panel beside your docs. No API
          yet? The mock environment answers from your spec's examples, so you can start anyway. The same files
          run from the terminal.
        </p>
      </div>
      <Snippet file="snippets/install.sh" region="develop" title={false} />

      <h2 class="title">Publish it</h2>
      <div class="prose">
        <p>
          Share what you wrote. QA gets a portal, your docs get Try it buttons, and production gets a single
          file that only needs node.
        </p>
      </div>
      <Snippet file="snippets/install.sh" region="publish" title={false} />
    </div>
  </section>

  <div class="wrap"><Next page="develop" /></div>
</Page>
