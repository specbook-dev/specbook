---
// Says whether the demo API (a service worker in this very page) is running, and resets its data.
interface Props {
  reset?: boolean
}
const { reset = true } = Astro.props
---

<span class="demo-status">
  <span class="chip" data-demo-status data-state="loading" role="status">
    <i></i><span class="label">Starting the demo API…</span>
  </span>
  <button type="button" class="chip action" data-demo-reload hidden>Reload</button>
  {reset && <button type="button" class="chip action" data-demo-reset disabled>Reset the demo data</button>}
</span>

<style>
  .demo-status {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .action {
    background: transparent;
    cursor: pointer;
    min-height: 28px;
  }
  .action:hover:not(:disabled) {
    color: var(--text);
    border-color: var(--accent);
  }
  .action:disabled {
    opacity: 0.5;
    cursor: default;
  }
</style>
