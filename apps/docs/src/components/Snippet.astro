---
// A block of code read from a real file (see lib/snippet.ts), in Starlight's code frame, with an optional Run button that
// opens the play panel on the very request or flow the code defines.
import { Code } from '@astrojs/starlight/components'
import { readSnippet } from '../lib/snippet'

interface Props {
  file: string
  region?: string
  lines?: string
  /** the frame's title; the file's name when not given */
  title?: string | false
  /** line numbers or ranges of the code shown to highlight, like `2,5-7` */
  mark?: string
  /** wrap long lines instead of scrolling sideways: for output that is read, not code that is copied */
  wrap?: boolean
  /** `flow:adopt-pet` or `try:requests/petstore/get-pet.req.ts` (the file shown, so its checks run): shows a Run button */
  run?: string
  /** preset flow inputs for the Run button */
  inputs?: Record<string, unknown>
}

const { file, region, lines, title, mark, wrap, run, inputs } = Astro.props
const snippet = readSnippet({ file, region, lines })
// `mark="7-9,18"` is line numbers and ranges of the code shown; a plain string would be searched for as text
const markers = mark
  ?.replace(/[{}\s]/g, '')
  .split(',')
  .filter(Boolean)
  .map((m) => (/^\d+$/.test(m) ? Number(m) : { range: m }))
const [kind, target] = run?.split(':') ?? []
const attr =
  kind === 'flow' ? 'data-specbook-flow' : kind === 'try' ? 'data-specbook-try' : undefined
---

<figure class="snippet">
  <Code
    code={snippet.code}
    lang={snippet.lang}
    title={title === false ? undefined : (title ?? snippet.name)}
    mark={markers}
    wrap={wrap}
  />
  {
    attr && target && (
      <p class="snippet-run">
        <button
          type="button"
          class="run"
          {...{ [attr]: target }}
          data-specbook-env="mock"
          data-specbook-inputs={inputs ? JSON.stringify(inputs) : undefined}
        >
          ▶ Run it
        </button>
        <span class="muted">on mock data, in this page</span>
      </p>
    )
  }
</figure>

<style>
  .snippet {
    margin: 0;
  }
  .snippet-run {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin: -6px 0 22px;
  }
  .muted {
    color: var(--muted);
    font-size: 14px;
  }
</style>
