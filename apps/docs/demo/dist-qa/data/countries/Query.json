{"schema":{"$id":"specbook://countries/Query.request","type":"object","description":"Run a GraphQL query\n\nSend a GraphQL document and its variables. The response always has a `data` object and, when something went wrong, an `errors` array.","properties":{"data":{"$ref":"specbook://countries/defs#/$defs/GraphqlRequest"}},"additionalProperties":false},"responses":{"200":{"$ref":"specbook://countries/defs#/$defs/GraphqlResponse"}},"docs":{"description":"Send a GraphQL document and its variables. The response always has a `data` object and, when something went wrong, an `errors` array.","examples":[{"name":"country","title":"One country by code","source":"spec"},{"name":"continents","title":"Every continent","source":"spec"},{"name":"default","title":"Default","source":"generated"}]},"examples":{"continents":{"name":"continents","title":"Every continent","source":"spec","body":{"query":"{\n  continents {\n    code\n    name\n  }\n}"}},"country":{"name":"country","title":"One country by code","source":"spec","body":{"query":"query Country($code: ID!) {\n  country(code: $code) {\n    name\n    capital\n    currency\n    languages {\n      name\n    }\n  }\n}","variables":{"code":"DE"}}},"default":{"name":"default","title":"Default","source":"generated","body":{"query":"Example query","operationName":"Example operation name"}}},"mock":{"200":{"data":{"country":{"name":"Germany","capital":"Berlin","currency":"EUR","languages":[{"name":"German"}]},"continents":[{"code":"AF","name":"Africa"},{"code":"AN","name":"Antarctica"},{"code":"AS","name":"Asia"},{"code":"EU","name":"Europe"},{"code":"NA","name":"North America"},{"code":"OC","name":"Oceania"},{"code":"SA","name":"South America"}]}}}}