{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:viewer": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:slow": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:oauth": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:embed": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:sw": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "example#build:docs": {
      "dependsOn": ["^build"],
      "outputs": ["dist-docs/**"]
    },
    "docs-demo#build:qa": {
      "dependsOn": ["^build"],
      "outputs": ["dist-qa/**"]
    },
    "docs-demo#build:sw": {
      "dependsOn": ["^build"],
      "outputs": ["dist-sw/**"]
    },
    "docs-demo#bundle": {
      "dependsOn": ["^build"],
      "outputs": ["dist-bundle/**"]
    },
    "@specbook/ui#build:viewer": {
      "dependsOn": ["^build"],
      "outputs": ["dist-viewer/**"]
    },
    "docs#build:site": {
      "dependsOn": [
        "^build",
        "example#build:docs",
        "docs-demo#build:qa",
        "docs-demo#build:sw",
        "@specbook/ui#build:viewer",
        "docs-demo#generate",
        "docs-demo#capture"
      ],
      "outputs": ["dist/**"]
    },
    "test:site": {
      "dependsOn": ["docs#build:site"],
      "cache": false
    },
    "docs-demo#generate": {
      "dependsOn": ["^build"],
      "outputs": [".generated/**"]
    },
    "docs#typecheck": {
      "dependsOn": ["^build", "docs-demo#generate", "docs-demo#capture"]
    },
    "docs#test": {
      "dependsOn": ["^build", "docs-demo#generate", "docs-demo#capture"]
    },
    "docs-demo#capture": {
      "dependsOn": ["^build", "docs-demo#generate", "docs-demo#bundle"],
      "outputs": ["captures/**"]
    }
  }
}
