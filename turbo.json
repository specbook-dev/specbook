{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:viewer": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:slow": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:browser": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:oauth": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test:embed": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
